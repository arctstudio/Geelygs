{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/test-drive", "destination": "/index.html" },
    { "source": "/daftar-harga-garansi", "destination": "/index.html" },
    { "source": "/hubungi-kami", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
